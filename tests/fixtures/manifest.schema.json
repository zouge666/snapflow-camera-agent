{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://snapflow.local/schemas/fixture-manifest-v1.json",
  "title": "SnapFlow evaluation fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "split",
    "languages",
    "scenario_tags",
    "source",
    "input",
    "gold"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 8,
      "maxLength": 96
    },
    "kind": {
      "enum": ["text", "image"]
    },
    "split": {
      "enum": ["dev", "holdout"]
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
      }
    },
    "scenario_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "source": {
      "$ref": "#/definitions/source"
    },
    "input": {
      "$ref": "#/definitions/input"
    },
    "gold": {
      "$ref": "#/definitions/gold"
    },
    "artifacts": {
      "$ref": "#/definitions/artifacts"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "image"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["artifacts"]
      }
    }
  ],
  "definitions": {
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "transcript", "source_design", "attribution"],
      "properties": {
        "image": {
          "$ref": "#/definitions/imageArtifact"
        },
        "transcript": {
          "$ref": "#/definitions/transcriptArtifact"
        },
        "source_design": {
          "$ref": "#/definitions/sourceDesignArtifact"
        },
        "attribution": {
          "$ref": "#/definitions/attributionArtifact"
        }
      }
    },
    "imageArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_path",
        "repository_path",
        "media_type",
        "width",
        "height",
        "sha256",
        "alt_text"
      ],
      "properties": {
        "public_path": {
          "type": "string",
          "pattern": "^/samples/[A-Za-z0-9._/-]+\\.png$"
        },
        "repository_path": {
          "type": "string",
          "pattern": "^apps/web/public/samples/[A-Za-z0-9._/-]+\\.png$"
        },
        "media_type": {
          "const": "image/png"
        },
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 4096
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "alt_text": {
          "type": "string",
          "minLength": 20,
          "maxLength": 240
        }
      }
    },
    "transcriptArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_path", "repository_path", "media_type", "sha256"],
      "properties": {
        "public_path": {
          "type": "string",
          "pattern": "^/samples/[A-Za-z0-9._/-]+\\.txt$"
        },
        "repository_path": {
          "type": "string",
          "pattern": "^apps/web/public/samples/[A-Za-z0-9._/-]+\\.txt$"
        },
        "media_type": {
          "const": "text/plain; charset=utf-8"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "sourceDesignArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_path", "repository_path", "media_type", "sha256"],
      "properties": {
        "public_path": {
          "type": "string",
          "pattern": "^/samples/[A-Za-z0-9._/-]+\\.svg$"
        },
        "repository_path": {
          "type": "string",
          "pattern": "^apps/web/public/samples/[A-Za-z0-9._/-]+\\.svg$"
        },
        "media_type": {
          "const": "image/svg+xml"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "attributionArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_path", "repository_path", "media_type", "sha256"],
      "properties": {
        "public_path": {
          "type": "string",
          "pattern": "^/samples/[A-Za-z0-9._/-]+\\.md$"
        },
        "repository_path": {
          "type": "string",
          "pattern": "^apps/web/public/samples/[A-Za-z0-9._/-]+\\.md$"
        },
        "media_type": {
          "const": "text/markdown; charset=utf-8"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "creator",
        "license",
        "source_url",
        "created_at",
        "contains_personal_data",
        "contains_confidential_data"
      ],
      "properties": {
        "provenance": {
          "enum": ["synthetic", "licensed"]
        },
        "creator": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "license": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "source_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "created_at": {
          "type": "string",
          "format": "date"
        },
        "contains_personal_data": {
          "const": false
        },
        "contains_confidential_data": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "licensed"
              }
            }
          },
          "then": {
            "properties": {
              "source_url": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "locale", "timezone", "reference_date"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
        },
        "timezone": {
          "type": "string",
          "pattern": "^[A-Za-z_]+(?:/[A-Za-z_+-]+)+$"
        },
        "reference_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_action_count",
        "actions",
        "clarifications",
        "forbidden_actions",
        "notes"
      ],
      "properties": {
        "expected_action_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "actions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/action"
          }
        },
        "clarifications": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/clarification"
          }
        },
        "forbidden_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 240
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "owner", "due", "priority", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^action-[1-9][0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "owner": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 120
        },
        "due": {
          "oneOf": [
            {
              "$ref": "#/definitions/due"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "enum": ["low", "medium", "high", "unknown"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/evidence"
          }
        }
      }
    },
    "due": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iso_date", "raw_text", "resolution"],
      "properties": {
        "iso_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "raw_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "resolution": {
          "enum": ["absolute", "relative", "ambiguous"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "start", "end"],
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "reason", "question_should_include", "evidence"],
      "properties": {
        "field_path": {
          "type": "string",
          "pattern": "^actions\\[[0-9]+\\]\\.[a-z_]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "question_should_include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "evidence": {
          "oneOf": [
            {
              "$ref": "#/definitions/evidence"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
