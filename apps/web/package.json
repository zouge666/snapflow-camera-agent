{
  "name": "@snapflow/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "format": "prettier --config prettier.config.mjs --write . ../../tests/e2e",
    "format:check": "prettier --config prettier.config.mjs --check . ../../tests/e2e",
    "lint": "eslint . --max-warnings=0",
    "prebuild": "node scripts/sync-ocr-assets.mjs",
    "predev": "node scripts/sync-ocr-assets.mjs",
    "prestart": "node scripts/sync-ocr-assets.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.generated.json"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "next": "16.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "27.0.0",
    "@types/node": "24.10.9",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.11.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.2",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "27.4.0",
    "prettier": "3.8.0",
    "typescript": "5.9.3",
    "vitest": "4.0.17"
  }
}
