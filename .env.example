APP_ENV=local
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
PUBLIC_GITHUB_URL=https://github.com/zouge666/snapflow-camera-agent

MODEL_PROVIDER=mock
MODEL_NAME=deepseek-v4-flash
RUN_TTL_HOURS=24
GUEST_SESSION_TTL_HOURS=24
GUEST_ACCESS_TOKEN_TTL_MINUTES=30
MAX_SOURCE_CHARS=12000
MAX_CLARIFICATIONS=2
MAX_PROVIDER_RETRIES=2

DEEPSEEK_API_KEY=
# Local host URL; Docker Compose overrides the hostname for its API container.
DATABASE_URL=postgresql+psycopg://snapflow:snapflow-local-only@127.0.0.1:5432/snapflow
# Generate locally with: openssl rand -hex 32
GUEST_TOKEN_SIGNING_KEY=
